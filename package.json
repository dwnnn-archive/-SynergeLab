{
  "name": "synergelab-kanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src worker scripts tests *.js *.json *.jsonc *.md index.html .github/workflows/*.yml",
    "format": "prettier --write src worker scripts tests *.js *.json *.jsonc *.md index.html .github/workflows/*.yml",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "start": "wrangler dev --local --ip 0.0.0.0 --port 4173 --persist-to .wrangler/state"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.10.1",
    "vite": "^7.2.2",
    "wrangler": "^4.162.0"
  }
}
